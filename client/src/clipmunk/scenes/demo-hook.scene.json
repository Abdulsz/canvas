{
  "version": 1,
  "id": "demo-hook",
  "title": "Design app screens by talking",
  "description": "Open on the result: the recorded conversation's finished dark login and menu flow in the real canvas.",
  "definition": {
    "width": 1920,
    "height": 1080,
    "scene": {
      "camera": {
        "x": 0,
        "y": 0,
        "z": 0,
        "rotateX": 0,
        "rotateY": 0,
        "rotateZ": 0,
        "perspective": 2400
      },
      "focus": {
        "distance": 2400,
        "fStop": 16,
        "focalLength": 50,
        "maxBlur": 4
      },
      "nodes": [
        {
          "id": "stage"
        },
        {
          "id": "caption",
          "parentId": "stage"
        },
        {
          "id": "meta",
          "parentId": "stage"
        },
        {
          "id": "window",
          "parentId": "stage",
          "transform": {
            "scale": 1.06
          }
        },
        {
          "id": "subtitle",
          "parentId": "stage"
        }
      ]
    },
    "motion": {
      "durationMs": 6000,
      "speed": 1,
      "tracks": [
        {
          "target": {
            "kind": "surface",
            "id": "window"
          },
          "property": "scale",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 1
            },
            {
              "timeMs": 5200,
              "value": 1.2
            }
          ]
        },
        {
          "target": {
            "kind": "surface",
            "id": "window"
          },
          "property": "y",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 30
            },
            {
              "timeMs": 5200,
              "value": 62
            }
          ]
        },
        {
          "target": {
            "kind": "surface",
            "id": "window"
          },
          "property": "opacity",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 0
            },
            {
              "timeMs": 500,
              "value": 1
            }
          ]
        },
        {
          "target": {
            "kind": "surface",
            "id": "window"
          },
          "property": "z",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 120
            },
            {
              "timeMs": 1400,
              "value": 0
            }
          ]
        }
      ]
    }
  },
  "snapshot": {
    "image": "data:image/png;base64,",
    "timeMs": 3000
  }
}
